# ---- Aqua Static environment ----
# Everything is optional for local development. The app runs with ZERO keys.
# Copy this file to .env and fill in what you have.

# SQLite file path (default: ./data/aqua.db). Any Node host with a persistent disk works.
DATABASE_URL=file:./data/aqua.db

# HMAC secret for signed HttpOnly guest sessions.
# `npm run setup` generates one for you if missing. Required in production.
AUTH_SECRET=

# Enables demo accounts, the Demo Control Panel and /api/demo/* routes. Never enable in production.
DEMO_MODE=true

# Public base URL used in deep links sent over iMessage.
APP_BASE_URL=http://localhost:3000

# Google Gemini (AI parsing, assistant, briefing scripts). Without it: deterministic local fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs (studio voice for Radio). Without it: browser speech synthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Optional second voice for two-host podcast mode.
ELEVENLABS_VOICE_ID_2=

# Photon Spectrum (iMessage agent). These are the exact names the spectrum-ts SDK reads.
# Get them at https://app.photon.codes . Without them: "Photon not connected", web app unaffected.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Protects POST /api/sources/refresh and /api/transit/refresh for scheduled jobs.
CRON_SECRET=

# Chapel Hill Transit GTFS static feed (verified public URL). Cached on disk for 24h.
TRANSIT_GTFS_URL=https://mychtransit.org/gtfs
