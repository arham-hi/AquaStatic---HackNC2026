# Copy to .env and fill in. Everything is optional; the app degrades gracefully.

# TigerData / Timescale Postgres connection string. Omit to use in-memory storage.
DATABASE_URL=

# Gemini. Omit to use the keyword-based fallback parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs. Omit to use the browser's built-in voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

PORT=3001
